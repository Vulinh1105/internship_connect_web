# Sao chép file này thành .env rồi sửa giá trị. KHÔNG push file .env lên GitHub.

# MySQL (XAMPP mặc định: user root, không mật khẩu)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/internship_connect?charset=utf8mb4

# Để true nếu muốn app tự tạo bảng còn thiếu khi khởi động (bảng đã có thì bỏ qua)
AUTO_CREATE_TABLES=true

# Chuỗi bí mật ký JWT: cả nhóm dùng chung, đặt dài và ngẫu nhiên
JWT_SECRET=Baitapmonlaptrinhwebcuanhom10000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=*

# --- AI ---
# auto: dùng Qdrant local nếu cài được, không thì dùng bộ nhớ | qdrant | memory
VECTOR_BACKEND=auto
QDRANT_PATH=./qdrant_data
# hashing: nhẹ, không cần tải model | sentence_transformers: chính xác hơn, cần cài thêm
EMBEDDING_BACKEND=hashing
# Tùy chọn: điền khóa để chatbot dùng LLM. Để trống thì chatbot trả lời bằng trích đoạn tài liệu (miễn phí)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
